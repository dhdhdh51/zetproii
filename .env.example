# =============================================================
# BharatAI Business OS - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# =============================================================

# ---- Application ----
APP_NAME="BharatAI Business OS"
APP_ENV=production            # local | staging | production
APP_DEBUG=false               # true only in local development
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata
APP_KEY=                      # 32+ char random string, used for encryption (php -r "echo bin2hex(random_bytes(32));")
APP_LOCALE=en

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bharatai
DB_USERNAME=bharatai
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- Session / Security ----
SESSION_SECURE_COOKIE=true    # set true when served over HTTPS
SESSION_LIFETIME=120          # minutes
CSRF_TOKEN_TTL=3600           # seconds
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=48

# ---- Mail (SMTP) ----
# Can also be configured per-installation via Admin > Settings > Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls           # tls | ssl | none
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="BharatAI Business OS"

# ---- AI Providers (fallback defaults; can be overridden in Admin > AI Providers) ----
# API keys are stored encrypted in the database. These env values are only
# used as an optional bootstrap/default when no DB-configured provider exists.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ---- Google OAuth (optional, configurable from Admin > Settings) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Payments (abstraction layer; enable per gateway from Admin) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ---- Cron ----
CRON_SECRET=change_this_to_a_long_random_string

# ---- File Uploads ----
MAX_UPLOAD_SIZE_MB=25
UPLOAD_PATH=storage/uploads
